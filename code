#include <Wire.h>
#include "SHTSensor.h"

SHTSensor sht;

void setup() {
  Serial.begin(115200);
  Wire.begin();

  if (!sht.init()) {
    Serial.println("Capteur non detecte !");
    while (1);
  }

  Serial.println("Temperature Humidite");
}

void loop() {
  if (sht.readSample()) {
    Serial.print(sht.getTemperature());
    Serial.print(" ");
    Serial.println(sht.getHumidity());
  } else {
    Serial.println("Erreur lecture capteur");
  }

  delay(1000);
}
